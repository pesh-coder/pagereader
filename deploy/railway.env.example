# Railway backend service variables. Keep the repository root as service root.
RAILPACK_NODE_VERSION=22.17.1
RAILPACK_PRUNE_DEPS=false
RAILPACK_NO_SPA=1
NODE_ENV=production
BSV_NETWORK=main
PAGESTREAM_STATE_DIR=/var/data/pagestream
PAGESTREAM_REQUIRE_EXISTING_STATE=1
PAGESTREAM_MAINTENANCE=1
SPIKE_MANIFEST=1
WALLET_STORAGE_URL=https://storage.babbage.systems
# Set the stable Vercel origin before normal activation; omit during first-host
# maintenance if necessary, which can use Railway's assigned public domain.
PUBLIC_ORIGIN=https://pagereader.vercel.app
# Existing receiving key: Railway secret UI only; never a reader's private key.
SERVER_PRIVATE_KEY=
# Railway supplies PORT and RAILWAY_PUBLIC_DOMAIN. Do not override them.
# Attach a volume at /var/data/pagestream; an env variable does not create it.
