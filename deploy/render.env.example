# First provisioning: health-only maintenance. No database/wallet is loaded.
NODE_VERSION=22.17.1
NODE_ENV=production
BSV_NETWORK=main
PAGESTREAM_STATE_DIR=/var/data/pagestream
PAGESTREAM_REQUIRE_EXISTING_STATE=1
PAGESTREAM_MAINTENANCE=1
SPIKE_MANIFEST=1
WALLET_STORAGE_URL=https://storage.babbage.systems
# Replace with Vercel's stable production origin, without /reader/.
PUBLIC_ORIGIN=https://YOUR-VERCEL-PROJECT.vercel.app
# Set only in Render's secret UI, using the existing local receiving key.
SERVER_PRIVATE_KEY=
# Render supplies PORT and RENDER_EXTERNAL_URL automatically; do not override.
