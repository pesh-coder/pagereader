{
  "name": "pagestream-tier1-spike",
  "private": true,
  "type": "module",
  "engines": { "node": ">=22.13.0" },
  "scripts": {
    "import:book": "tsx scripts/import-book.ts",
    "import:catalogue": "tsx scripts/import-catalogue.ts",
    "build": "tsc --noEmit && node scripts/build.mjs",
    "dev": "node --env-file-if-exists=.env --import tsx src/server.ts",
    "test": "node --import tsx --test test/*.test.ts",
    "report": "tsx scripts/report.ts",
    "preflight:recovery": "tsx scripts/recovery-preflight.ts",
    "review:permission-cost": "tsx scripts/review-permission-cost.ts"
  },
  "dependencies": {
    "@bsv/auth-express-middleware": "2.2.9",
    "@bsv/payment-express-middleware": "2.1.9",
    "@bsv/sdk": "2.8.11",
    "@bsv/wallet-toolbox-client": "2.14.9",
    "express": "5.1.0"
  },
  "devDependencies": {
    "@types/express": "5.0.3",
    "@types/node": "22.18.6",
    "esbuild": "0.28.2",
    "tsx": "4.20.6",
    "typescript": "5.8.3"
  }
}
