# Receiving wallet key: set locally; never paste into chat or commit it.
SERVER_PRIVATE_KEY=
BSV_NETWORK=main
PORT=3108
# Explicit remote storage provider; the key must remain stable across restarts.
WALLET_STORAGE_URL=https://storage.babbage.systems
# Set to the SAME public HTTPS origin used on both devices before live tests.
PUBLIC_ORIGIN=http://localhost:3108
# For E1, restart with 0 on a separate clean HTTPS origin; revoke grants first.
SPIKE_MANIFEST=1
# Research UI and legacy routes are disabled unless explicitly opted in during development.
# Production ignores this flag even if it is set.
PAGESTREAM_RESEARCH=0
