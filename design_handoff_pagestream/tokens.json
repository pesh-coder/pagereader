{
  "color": {
    "light": {
      "paper": "#FFFFFF",
      "paper-shade": "#EAE2D3",
      "ink": "#221D18",
      "pencil": "#6E655B",
      "rubric": "#B4441C",
      "rule": "#CFC5B4",
      "error": "#8E1F14"
    },
    "night": {
      "paper": "#1F1A15",
      "paper-shade": "#2A241D",
      "ink": "#E9E0D0",
      "pencil": "#A89C8B",
      "rubric": "#E0784A",
      "rule": "#3B342B",
      "error": "#E58A7C"
    },
    "rubricUsage": ["counter numerals", "price on Next / paid action", "FREE PREVIEW stamp", "chapter drop caps", "prices in copy"]
  },
  "font": {
    "display": { "family": "IM Fell English", "source": "Google Fonts", "minSize": 28, "use": ["book titles", "wordmark", "page h1"] },
    "body": { "family": "Literata", "source": "Google Fonts", "axes": "opsz 7..72, wght 400/600, italic 400", "use": ["reading", "all UI"] },
    "figures": { "fontVariantCaps": "all-small-caps", "fontVariantNumeric": "tabular-nums lining-nums", "letterSpacing": "0.04em–0.06em", "use": ["labels", "prices", "counter"] },
    "monospace": "banned"
  },
  "type": {
    "display":    { "family": "display", "size": 36, "lineHeight": 1.08 },
    "h1":         { "family": "display", "size": 34, "lineHeight": 1.1 },
    "pageTitle":  { "family": "display", "size": 32, "lineHeight": 1.1 },
    "rowTitle":   { "family": "display", "size": 28, "lineHeight": 1.12 },
    "wordmark":   { "family": "display", "size": 30, "lineHeight": 1 },
    "reading":    { "family": "body", "size": 19, "lineHeight": 1.6, "range": [17, 24], "align": "left", "hyphens": "auto", "justify": false },
    "ui":         { "family": "body", "size": 17, "lineHeight": 1.5 },
    "panelHead":  { "family": "body", "size": 20, "weight": 600, "lineHeight": 1.35 },
    "label":      { "family": "body", "size": 15, "smallCaps": true, "tabular": true },
    "counter":    { "family": "body", "size": 28, "smallCaps": true, "tabular": true, "color": "rubric" },
    "dropCap":    { "family": "display", "size": "4em", "lineHeight": 0.82, "color": "rubric", "float": "left" }
  },
  "spacing": [4, 8, 12, 16, 24, 32, 48, 64],
  "radius": 0,
  "shadow": "none",
  "blur": "none",
  "rule": { "structure": "1px solid ink", "quiet": "1px solid rule" },
  "touchTarget": 44,
  "buttonHeight": 48,
  "layout": { "container": 1200, "gutter": 20, "measure": "35em", "wideBreakpoint": 960, "catalogueAside": 440, "readerAside": 280 },
  "motion": {
    "pageTurn": "opacity 60ms out + 60ms in (≤120ms total), linear",
    "counterTick": "1px rubric underline, background-size 0→100% over 150ms ease-out, cleared after 700ms",
    "reducedMotion": "disable all transitions"
  },
  "states": {
    "hover":    "background paper-shade + inset 0 -3px 0 ink (buttons) / inset 0 -1px 0 ink (rows, text buttons)",
    "selected": "background paper-shade + inset 0 1px 0 ink + inset 0 -1px 0 ink",
    "focus":    "outline 2px solid ink, offset 2px",
    "never":    "border-only or scale-only changes; rubric for state"
  },
  "pricing": { "pricePerPageSats": 5, "freePages": 2, "feePerPageSats": 1, "feeIsPlaceholder": true, "walletLimitSats": 5000, "walletLimitIsProvisional": true }
}
